{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.mjs",
    ".github/scripts/*.mjs",
    "packages/*/scripts/*.mjs",
    "packages/*/bench/*.mjs",
    "apps/chrome-extension/*.mjs"
  ]
}
