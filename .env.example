# Documentation only. pnpm setup:local creates ignored apps/web/.dev.vars.
# Production values must be configured as Worker secrets / environment bindings.
PUBLIC_APP_ORIGIN=https://YOUR_OFFICIAL_HOST
BETTER_AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
SHARE_TOKEN_SECRET=GENERATE_ANOTHER_INDEPENDENT_RANDOM_SECRET
TURNSTILE_SITE_KEY=YOUR_PUBLIC_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_SECRET_KEY
TURNSTILE_HOSTNAMES=YOUR_OFFICIAL_HOST
RESEND_API_KEY=YOUR_MAIL_API_KEY
MAIL_FROM=FlashGuard <YOUR_VERIFIED_SENDER>
MODERATOR_USER_IDS=
# No production LOCAL_TURNSTILE_FIXTURE. Real D1 IDs and limiter bindings required.
