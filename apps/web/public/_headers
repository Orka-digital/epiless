# Static Asset responses only. SSR/API headers are set in src/middleware.ts.
# Astro emits page-specific script/style hashes in its HTML CSP meta element.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# Only fingerprinted build assets are immutable. HTML and fixed-name downloads
# retain Cloudflare's revalidation default; report/API data is never served here.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
