---
import type { AuditReport } from '@epi-less/core';
import {
  paginateReport,
  type ReportPagination,
} from '../lib/report-pagination';
import ReportHeader from './report/ReportHeader.astro';
import ReportRoutes from './report/ReportRoutes.astro';
import ReportLimitations from './report/ReportLimitations.astro';
import ReportSidebar from './report/ReportSidebar.astro';
/** Compose static report sections; pagination and evidence remain server-rendered. */
interface Props {
  report: AuditReport;
  example?: boolean;
  pagination?: ReportPagination;
  pageHref?: (page: number, notes: number) => string;
}
const {
  report,
  example = false,
  pagination = paginateReport(report),
  pageHref,
} = Astro.props;
---

<article class="audit-sheet">
  <ReportHeader report={report} pagination={pagination} example={example} />
  <div class="audit-layout">
    <div class="audit-main">
      <ReportRoutes
        pagination={pagination}
        routeCount={report.routes.length}
        pageHref={pageHref}
      />
      <ReportLimitations pagination={pagination} pageHref={pageHref} />
    </div>
    <ReportSidebar report={report} />
  </div>
</article>
<style>
  .audit-sheet {
    margin-block: 24px;
  }
  .audit-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 24px;
    align-items: start;
    margin-top: 24px;
  }
  .audit-main {
    min-width: 0;
  }
  .audit-sheet :global(.audit-section) {
    margin: 0;
    padding-top: 0;
    border-top: 0;
  }
  .audit-sheet :global(.audit-section + .audit-section) {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .audit-sheet :global(.section-title) {
    margin-bottom: 14px;
  }
  .audit-sheet :global(.section-title h2) {
    font: 650 16px/1.4 var(--body);
    letter-spacing: -0.02em;
  }
  .audit-sheet :global(.section-title p) {
    margin-top: 6px;
    color: var(--muted);
    font-size: 12px;
  }
  .audit-sheet :global(.detail-paging) {
    margin-block: 12px 16px;
    font-size: 12px;
  }
  .audit-sheet :global(.detail-paging .actions) {
    margin-top: 10px;
  }
  @media (max-width: 1000px) {
    .audit-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }
  }
  @media (max-width: 600px) {
    .audit-sheet {
      margin-top: 18px;
    }
  }
</style>
