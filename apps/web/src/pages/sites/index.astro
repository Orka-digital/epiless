---
export const prerender = false;
import IndexSearch from '../../components/IndexSearch.astro';
import Shell from '../../layouts/Shell.astro';
import Status from '../../components/Status.astro';
import { getRuntime, listSites, HttpError } from '../../server';
import { hostLabel, dateLabel } from '../../lib/display';
const query = (Astro.url.searchParams.get('q') || '').slice(0, 100);
const filters = Object.fromEntries(
  ['status', 'from', 'to', 'criterion'].map((key) => [
    key,
    Astro.url.searchParams.get(key) || '',
  ]),
);
let results: Awaited<ReturnType<typeof listSites>> = {
  items: [],
  nextCursor: null,
};
let unavailable = false;
let queryError = '';
try {
  results = await listSites(getRuntime(Astro), {
    query,
    ...filters,
    cursor: Astro.url.searchParams.get('cursor') || undefined,
  });
} catch (error) {
  if (error instanceof HttpError && error.status === 400) {
    queryError = error.message;
    Astro.response.status = 400;
  } else {
    unavailable = true;
    Astro.response.status = 503;
  }
}
const next = new URLSearchParams({
  q: query,
  ...filters,
  ...(results.nextCursor ? { cursor: results.nextCursor } : {}),
});
---

<Shell title="Openbare index" active="index">
  <div class="wrap page-head index-heading">
    <h1>Openbare index</h1>
    <p>Zoek openbaar gedeelde auditrapporten op domeinnaam.</p>
  </div>
  <div class="wrap page-content index-workspace">
    <IndexSearch query={query} filters={filters} />
    {queryError ? (
      <div class="notice error" role="alert">
        {queryError}
      </div>
    ) : unavailable ? (
      <div class="notice error" role="status">
        De index is tijdelijk niet beschikbaar. Probeer het later opnieuw.
      </div>
    ) : results.items.length === 0 ? (
      <div class="index-empty">
        <h2>
          {query
            ? 'Nog geen rapport voor deze zoekopdracht.'
            : 'Nog geen openbare rapporten.'}
        </h2>
        <p>
          {query
            ? 'Probeer de domeinnaam zonder pad. Alleen openbaar gedeelde rapporten verschijnen in de index.'
            : 'Een rapport verschijnt hier nadat de eigenaar het openbaar heeft gedeeld.'}
        </p>
        <a href="/voorbeeld">Voorbeeldrapport bekijken</a>
      </div>
    ) : (
      <section class="index-results" aria-label="Zoekresultaten">
        <div class="results-heading">
          <h2>{query ? 'Zoekresultaten' : 'Rapporten'}</h2>
          <span>{results.items.length} op deze pagina</span>
        </div>
        <div
          class="table-wrap"
          tabindex="0"
          role="region"
          aria-label="Openbare auditrapporten"
        >
          <table>
            <thead>
              <tr>
                <th>Website / rapport</th>
                <th>Meetuitkomst</th>
                <th>Gemeten routes</th>
                <th>Auditdatum</th>
              </tr>
            </thead>
            <tbody>
              {results.items.map((p) => (
                <tr>
                  <td>
                    <a class="result-domain" href={`/reports/${p.id}`}>
                      <strong>{hostLabel(p.origin)}</strong>
                    </a>
                    <br />
                    <a
                      class="fine"
                      href={`/sites/site?origin=${encodeURIComponent(p.origin)}`}
                    >
                      Alle rapporten van dit domein
                    </a>
                  </td>
                  <td>
                    <Status value={p.status} />
                  </td>
                  <td>
                    {p.measuredRoutes} / {p.discoveredRoutes}
                    <br />
                    <span class="fine">{p.scenarioCount} scenario’s</span>
                  </td>
                  <td>{dateLabel(p.auditedAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {results.nextCursor && (
          <div class="actions">
            <a class="button outline" href={`/sites?${next}`}>
              Volgende resultaten <span aria-hidden="true">→</span>
            </a>
          </div>
        )}
      </section>
    )}
    <p class="index-note">
      Rapporten zijn door gebruikers aangeleverd. Controleer de meetdatum, scope
      en beperkingen; een uitkomst is geen veiligheidsscore.{' '}
      <a href="/docs">Meetmethode</a>
    </p>
  </div>
</Shell>

<style>
  .index-heading {
    padding-bottom: 22px;
  }
  .index-heading h1 {
    font: 700 clamp(26px, 3vw, 32px)/1.2 var(--body);
  }
  .index-heading p {
    margin-top: 8px;
    font-size: 13px;
  }
  .index-workspace {
    padding-top: 0;
  }
  .index-empty {
    padding: 28px 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .index-empty h2 {
    font: 650 16px/1.4 var(--body);
    letter-spacing: -0.02em;
  }
  .index-empty p {
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .index-empty > a {
    display: inline-block;
    margin-top: 16px;
    font-size: 12px;
  }
  .results-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }
  .results-heading h2 {
    font: 650 16px/1.4 var(--body);
  }
  .results-heading span {
    color: var(--muted);
    font-size: 12px;
  }
  .table-wrap {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  table {
    min-width: 600px;
    font-size: 12px;
  }
  th,
  td {
    padding: 13px 16px;
  }
  td {
    vertical-align: middle;
  }
  .result-domain {
    font-size: 13px;
    text-decoration: none;
  }
  .result-domain:hover {
    text-decoration: underline;
  }
  td a.fine {
    display: inline-block;
    margin-top: 4px;
    font-size: 11px;
  }
  .index-note {
    color: var(--muted);
    font-size: 12px;
    margin-top: 18px;
    max-width: 100ch;
  }
  .index-note a {
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .index-empty {
      padding: 22px 18px;
    }
  }
</style>
