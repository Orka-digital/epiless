---
export const prerender = false;
import Shell from '../../layouts/Shell.astro';
import Status from '../../components/Status.astro';
import { getRuntime, listSites, HttpError } from '../../server';
import { hostLabel, dateLabel } from '../../lib/display';
const query = (Astro.url.searchParams.get('q') || '').slice(0, 100);
const filters = Object.fromEntries(
  ['status', 'from', 'to', 'criterion'].map((key) => [
    key,
    Astro.url.searchParams.get(key) || '',
  ]),
);
let results: Awaited<ReturnType<typeof listSites>> = {
  items: [],
  nextCursor: null,
};
let unavailable = false;
let queryError = '';
try {
  results = await listSites(getRuntime(Astro), {
    query,
    ...filters,
    cursor: Astro.url.searchParams.get('cursor') || undefined,
  });
} catch (error) {
  if (error instanceof HttpError && error.status === 400) {
    queryError = error.message;
    Astro.response.status = 400;
  } else {
    unavailable = true;
    Astro.response.status = 503;
  }
}
const next = new URLSearchParams({
  q: query,
  ...filters,
  ...(results.nextCursor ? { cursor: results.nextCursor } : {}),
});
---

<Shell title="Openbare index" active="index">
  <div class="wrap page-head index-heading">
    <h1>Openbare index</h1>
    <p>Zoek openbaar gedeelde auditrapporten op domeinnaam.</p>
  </div>
  <div class="wrap page-content index-workspace">
    <form class="search-form" action="/sites" method="get" role="search">
      <label for="search">Domeinnaam</label>
      <div class="search-controls">
        <input
          id="search"
          name="q"
          type="search"
          value={query}
          placeholder="voorbeeld.be"
          maxlength="100"
        />
        <button class="button" type="submit">
          Zoeken
        </button>
        {(query || Object.values(filters).some(Boolean)) && (
          <a href="/sites">Wis filters</a>
        )}
      </div>
      <details
        class="index-filter-disclosure"
        open={Object.values(filters).some(Boolean)}
      >
        <summary>
          Filters <span>Meetuitkomst, datum en criterium</span>
        </summary>
        <div class="index-filters">
          <div>
            <label for="filter-status">Meetuitkomst</label>
            <select id="filter-status" name="status">
              <option value="">Alle uitkomsten</option>
              <option
                value="NEEDS_REVIEW"
                selected={filters.status === 'NEEDS_REVIEW'}
              >
                Beoordeling nodig
              </option>
              <option
                value="INCONCLUSIVE"
                selected={filters.status === 'INCONCLUSIVE'}
              >
                Onbeslisbaar
              </option>
              <option
                value="NO_ISSUES_OBSERVED"
                selected={filters.status === 'NO_ISSUES_OBSERVED'}
              >
                Geen problemen waargenomen
              </option>
              <option value="ERROR" selected={filters.status === 'ERROR'}>
                Meting mislukt
              </option>
            </select>
          </div>
          <div>
            <label for="filter-from">Gemeten vanaf (UTC)</label>
            <input
              id="filter-from"
              name="from"
              type="date"
              value={filters.from}
            />
          </div>
          <div>
            <label for="filter-to">Gemeten tot en met (UTC)</label>
            <input id="filter-to" name="to" type="date" value={filters.to} />
          </div>
          <div>
            <label for="filter-criterion">Criterium</label>
            <select id="filter-criterion" name="criterion">
              <option value="">Alle rapporten</option>
              <option value="2.3.1" selected={filters.criterion === '2.3.1'}>
                2.3.1 — meting voor beoordeling
              </option>
              <option value="2.3.2" selected={filters.criterion === '2.3.2'}>
                2.3.2 — meting voor beoordeling
              </option>
            </select>
          </div>
        </div>
        <p class="fine filter-note">
          Criteria tonen rapporten met gemeten flitsscenario's. De kandidaten
          zijn nog geen normatief oordeel.
        </p>
        <button class="button outline small" type="submit">
          Filters toepassen
        </button>
      </details>
    </form>
    {queryError ? (
      <div class="notice error" role="alert">
        {queryError}
      </div>
    ) : unavailable ? (
      <div class="notice error" role="status">
        De index is tijdelijk niet beschikbaar. Probeer het later opnieuw.
      </div>
    ) : results.items.length === 0 ? (
      <div class="index-empty">
        <h2>
          {query
            ? 'Nog geen rapport voor deze zoekopdracht.'
            : 'Nog geen openbare rapporten.'}
        </h2>
        <p>
          {query
            ? 'Probeer de domeinnaam zonder pad. Alleen openbaar gedeelde rapporten verschijnen in de index.'
            : 'Een rapport verschijnt hier nadat de eigenaar het openbaar heeft gedeeld.'}
        </p>
        <a href="/voorbeeld">Voorbeeldrapport bekijken</a>
      </div>
    ) : (
      <section class="index-results" aria-label="Zoekresultaten">
        <div class="results-heading">
          <h2>{query ? 'Zoekresultaten' : 'Rapporten'}</h2>
          <span>{results.items.length} op deze pagina</span>
        </div>
        <div
          class="table-wrap"
          tabindex="0"
          role="region"
          aria-label="Openbare auditrapporten"
        >
          <table>
            <thead>
              <tr>
                <th>Website / rapport</th>
                <th>Meetuitkomst</th>
                <th>Gemeten routes</th>
                <th>Auditdatum</th>
              </tr>
            </thead>
            <tbody>
              {results.items.map((p) => (
                <tr>
                  <td>
                    <a class="result-domain" href={`/reports/${p.id}`}>
                      <strong>{hostLabel(p.origin)}</strong>
                    </a>
                    <br />
                    <a
                      class="fine"
                      href={`/sites/site?origin=${encodeURIComponent(p.origin)}`}
                    >
                      Alle rapporten van dit domein
                    </a>
                  </td>
                  <td>
                    <Status value={p.status} />
                  </td>
                  <td>
                    {p.measuredRoutes} / {p.discoveredRoutes}
                    <br />
                    <span class="fine">{p.scenarioCount} scenario’s</span>
                  </td>
                  <td>{dateLabel(p.auditedAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {results.nextCursor && (
          <div class="actions">
            <a class="button outline" href={`/sites?${next}`}>
              Volgende resultaten <span aria-hidden="true">→</span>
            </a>
          </div>
        )}
      </section>
    )}
    <p class="index-note">
      Rapporten zijn door gebruikers aangeleverd. Controleer de meetdatum, scope
      en beperkingen; een uitkomst is geen veiligheidsscore.{' '}
      <a href="/docs">Meetmethode</a>
    </p>
  </div>
</Shell>

<style>
  .index-filter-disclosure {
    margin-top: 16px;
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }
  .index-filter-disclosure > summary {
    font-size: 12px;
    font-weight: 600;
  }
  .index-filter-disclosure > summary span {
    font-weight: 400;
    color: var(--muted);
    margin-left: 8px;
    font-size: 11px;
  }

  .index-filters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 16px;
  }
  .index-filters input,
  .index-filters select {
    width: 100%;
    min-width: 0;
    font-size: 12px;
  }
  .filter-note {
    margin-top: 10px;
  }
  @media (max-width: 900px) {
    .index-filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .index-filters {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .index-heading {
    padding-bottom: 22px;
  }
  .index-heading h1 {
    font: 700 clamp(26px, 3vw, 32px)/1.2 var(--body);
  }
  .index-heading p {
    margin-top: 8px;
    font-size: 13px;
  }
  .index-workspace {
    padding-top: 0;
  }
  .search-form {
    display: block;
    max-width: none;
    margin: 0 0 22px;
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .search-form label {
    display: block;
    margin-bottom: 8px;
    font-size: 12px;
  }
  .search-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .search-controls input {
    flex: 1;
    max-width: 500px;
    min-width: 0;
    font-size: 13px;
  }
  .search-controls .button {
    min-width: 90px;
  }
  .search-controls a {
    font-size: 12px;
  }
  .index-empty {
    padding: 28px 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .index-empty h2 {
    font: 650 16px/1.4 var(--body);
    letter-spacing: -0.02em;
  }
  .index-empty p {
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .index-empty > a {
    display: inline-block;
    margin-top: 16px;
    font-size: 12px;
  }
  .results-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }
  .results-heading h2 {
    font: 650 16px/1.4 var(--body);
  }
  .results-heading span {
    color: var(--muted);
    font-size: 12px;
  }
  .table-wrap {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  table {
    min-width: 600px;
    font-size: 12px;
  }
  th,
  td {
    padding: 13px 16px;
  }
  td {
    vertical-align: middle;
  }
  .result-domain {
    font-size: 13px;
    text-decoration: none;
  }
  .result-domain:hover {
    text-decoration: underline;
  }
  td a.fine {
    display: inline-block;
    margin-top: 4px;
    font-size: 11px;
  }
  .index-note {
    color: var(--muted);
    font-size: 12px;
    margin-top: 18px;
    max-width: 100ch;
  }
  .index-note a {
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .search-form {
      padding: 16px;
    }
    .search-controls {
      flex-wrap: wrap;
    }
    .search-controls input {
      flex-basis: calc(100% - 100px);
      width: 0;
    }
    .index-empty {
      padding: 22px 18px;
    }
  }
</style>
