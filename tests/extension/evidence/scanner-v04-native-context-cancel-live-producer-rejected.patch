+/** A cleanup timeout bounds waiting; it never grants a new capture or extends
+ * the independent offscreen watchdog. A late read is ignored by its caller. */
+export function cleanupTimeRemaining(
+  deadlineEpochMs: number,
+  now = Date.now(),
+): number {
+  const remaining = deadlineEpochMs - now;
+  if (!Number.isFinite(remaining) || remaining <= 0 || remaining > 2500)
+    throw new Error('CAPTURE_CLEANUP_EXPIRED');
+  return remaining;
+}
+
+export async function withinCleanupDeadline<T>(
+  deadlineEpochMs: number,
+  action: () => Promise<T>,
+): Promise<T> {
+  const remaining = cleanupTimeRemaining(deadlineEpochMs);
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  try {
+    return await Promise.race([
+      action(),
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(
+          () => reject(new Error('CAPTURE_CLEANUP_EXPIRED')),
+          remaining,
+        );
+      }),
+    ]);
+  } finally {
+    if (timer) clearTimeout(timer);
+  }
+}
