+import { afterEach, describe, expect, it, vi } from 'vitest';
+import {
+  cleanupTimeRemaining,
+  withinCleanupDeadline,
+} from '../../apps/chrome-extension/src/capture-cleanup';
+
+afterEach(() => vi.useRealTimers());
+
+describe('absolute live-capture cleanup deadline', () => {
+  it('rejects an expired, unbounded or renewed deadline before starting another read', async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(10_000);
+    const read = vi.fn(async () => 1);
+    for (const deadline of [10_000, 9999, 12_501, Infinity, NaN])
+      await expect(withinCleanupDeadline(deadline, read)).rejects.toThrow(
+        'CAPTURE_CLEANUP_EXPIRED',
+      );
+    expect(read).not.toHaveBeenCalled();
+    expect(cleanupTimeRemaining(12_500)).toBe(2500);
+  });
+
+  it('ignores a delayed DOM response after timeout, without running its following restore mutation', async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(10_000);
+    let resolve!: (value: number) => void;
+    const resize = vi.fn();
+    const task = (async () => {
+      const value = await withinCleanupDeadline(
+        12_500,
+        () =>
+          new Promise<number>((done) => {
+            resolve = done;
+          }),
+      );
+      resize(value);
+    })();
+    const rejected = expect(task).rejects.toThrow('CAPTURE_CLEANUP_EXPIRED');
+    await vi.advanceTimersByTimeAsync(2500);
+    await rejected;
+    resolve(507);
+    await Promise.resolve();
+    expect(resize).not.toHaveBeenCalled();
+  });
+});
