+/** One bounded native resize can invalidate a renderer's stale height after
+ * debugger chrome disappears. This is only a refresh trigger: the measured
+ * pre-attach CSS viewport remains the acceptance condition. Never enlarge the
+ * covered window, change focus, or repeat this if Chromium does not reflow. */
+async function refreshDetachedWorkspaceHeight(options: {
+  workspace: ViewportWorkspace;
+  driver: WorkspaceDriver;
+  read(): Promise<PageInventory['viewport']>;
+  wait(ms: number): Promise<void>;
+}): Promise<void> {
+  const { workspace, driver } = options;
+  const guard = () => assertViewportWorkspace(workspace, driver);
+  await guard();
+  const current = await driver.window(workspace.windowId);
+  const original = workspace.originalWindow;
+  if (
+    original.height <= 1 ||
+    (['width', 'height', 'left', 'top'] as const).some(
+      (key) => current[key] !== original[key],
+    )
+  )
+    throw new Error('VIEWPORT_LAYOUT_REFRESH_BOUNDS_CHANGED');
+  try {
+    await guard();
+    await driver.resize(workspace.windowId, {
+      ...original,
+      height: original.height - 1,
+    });
+    await guard();
+    const reached = await driver.window(workspace.windowId);
+    if (reached.height !== original.height - 1)
+      throw new Error('VIEWPORT_LAYOUT_REFRESH_NOT_REACHED');
+    // Read actual CSS while smaller, without inventing a relationship between
+    // browser chrome height and document height.
+    await waitForStableViewport({ ...options, guard });
+  } finally {
+    // If the user takes over the workspace, stop touching it. Otherwise restore
+    // its exact outer bounds even when the refresh/read failed.
+    await guard();
+    await driver.resize(workspace.windowId, original);
+  }
+}
