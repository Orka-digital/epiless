+describe('one fresh workspace after confirmed debugger release', () => {
+  async function setup() {
+    const f = fixture();
+    const workspace = await createViewportWorkspace(f.options);
+    workspace.detachedViewport = { width: 900, height: 507, dpr: 2 };
+    const storage: Record<string, unknown> = {
+      lease: structuredClone(workspace),
+    };
+    let released = false;
+    let latest = workspace;
+    f.driver.create = vi.fn(async (tabId, bounds) => {
+      expect(released).toBe(true);
+      expect(storage.lease).toBe(null);
+      expect(storage.intent).toEqual({
+        tabId: 11,
+        originalWindowId: 1,
+        originalIndex: 2,
+      });
+      expect(tabId).toBe(11);
+      expect(bounds).toEqual(workspace.originalWindow);
+      f.target.windowId = 3;
+      f.target.active = true;
+      f.target.index = 0;
+      const win = { ...f.original, ...bounds, id: 3, focused: false };
+      f.windows.set(3, win);
+      f.setGeometry({ width: 900, height: 507, dpr: 2 });
+      return win;
+    });
+    const recovery = {
+      guard: vi.fn(async () => {
+        expect(released).toBe(true);
+      }),
+      rememberIntent: vi.fn(async (intent) => {
+        expect(f.target.windowId).toBe(2);
+        Object.assign(storage, { lease: null, intent });
+      }),
+      remember: vi.fn(async (replacement: ViewportWorkspace) => {
+        latest = replacement;
+        expect(f.target.windowId).toBe(3);
+        expect(replacement.detachedWindowRecreated).toBe(true);
+        expect(replacement.originalWindowId).toBe(1);
+        expect(replacement.originalViewport).toEqual(
+          workspace.originalViewport,
+        );
+        expect(replacement.detachedViewport).toEqual(
+          workspace.detachedViewport,
+        );
+        storage.lease = structuredClone(replacement);
+      }),
+    };
+    return {
+      f,
+      workspace,
+      storage,
+      recovery,
+      get latest() {
+        return latest;
+      },
+      options: {
+        workspace,
+        ...f.options,
+        releaseDebugger: async () => {
+          released = true;
+        },
+        recreateAfterDetach: recovery,
+      },
+    };
+  }
+
+  it('persists original intent before reparenting and the new lease before reading actual CSS, then returns inactive', async () => {
+    const s = await setup();
+    const read = s.f.options.read;
+    s.options.read = vi.fn(async () => {
+      if (s.f.target.windowId === 3)
+        expect(s.storage.lease).toMatchObject({
+          windowId: 3,
+          detachedWindowRecreated: true,
+        });
+      return read();
+    });
+    s.f.addUserTab();
+    await restoreViewportWorkspace(s.options);
+    expect(s.f.driver.create).toHaveBeenCalledOnce();
+    expect(s.recovery.remember).toHaveBeenCalledOnce();
+    expect(s.latest).toMatchObject({
+      windowId: 3,
+      originalWindowId: 1,
+      originalIndex: 2,
+    });
+    expect(s.f.target).toMatchObject({ windowId: 1, index: 2, active: false });
+    expect(s.f.windows.get(2)).toBeDefined(); // No windows.remove can delete user tabs.
+    expect(s.f.original).toMatchObject({
+      width: 900,
+      height: 650,
+      focused: true,
