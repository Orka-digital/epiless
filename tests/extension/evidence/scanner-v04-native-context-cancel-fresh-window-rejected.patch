+interface DetachedWorkspaceRecovery {
+  /** Confirm this job still owns cleanup and no capture/debugger is attached. */
+  guard(): Promise<unknown>;
+  /** Revoke the old automatic lease and persist the ORIGINAL manual location
+   * atomically, before Chrome can move the tab into an as-yet unknown window. */
+  rememberIntent(intent: ViewportMoveIntent): Promise<void>;
+  /** Persist the new window ID before any other read/guard can fail. */
+  remember(workspace: ViewportWorkspace): Promise<void>;
+}
+
+async function recreateDetachedWorkspace(options: {
+  workspace: ViewportWorkspace;
+  driver: WorkspaceDriver;
+  recovery: DetachedWorkspaceRecovery;
+  remember(workspace: ViewportWorkspace): Promise<void>;
+}): Promise<ViewportWorkspace> {
+  const { workspace, driver, recovery } = options;
+  const guard = async () => {
+    await recovery.guard();
+    await assertViewportWorkspace(workspace, driver);
+    const tab = await driver.tab(workspace.tabId);
+    if (tab.pinned || tab.groupId >= 0)
+      throw new Error('VIEWPORT_WORKSPACE_ORGANIZATION_CHANGED');
+  };
+  await guard();
+  await recovery.rememberIntent({
+    tabId: workspace.tabId,
+    originalWindowId: workspace.originalWindowId,
+    originalIndex: workspace.originalIndex,
+  });
+  await guard();
+  // Reparent the same document into a freshly initialized, unfocused browser
+  // window. No reload, frame fabrication, focus change or chrome-height guess.
+  const window = await driver.create(workspace.tabId, workspace.originalWindow);
+  if (window.id === undefined)
+    throw new Error('VIEWPORT_WORKSPACE_WINDOW_UNAVAILABLE');
+  const replacement: ViewportWorkspace = {
+    ...workspace,
+    windowId: window.id,
+    detachedWindowRecreated: true,
+  };
+  // A worker death between create() and this write leaves only manual intent.
+  // The caller adopts the ID synchronously before the persistence await, so a
+  // failed write still permits safe in-process return of the actual moved tab.
+  await options.remember(replacement);
+  await recovery.guard();
+  await assertViewportWorkspace(replacement, driver);
+  const reached = await driver.window(replacement.windowId);
+  if (
+    (['width', 'height', 'left', 'top'] as const).some(
+      (key) => reached[key] !== replacement.originalWindow[key],
+    )
+  )
+    throw new Error('VIEWPORT_RECREATED_WINDOW_BOUNDS_UNCONFIRMED');
+  return replacement;
+}
